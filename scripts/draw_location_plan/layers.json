    "inf_lp_gabions":     { "color": 83,              "lineweight": "default", "linetype": "Continuous" },
    "inf_lp_stations":    { "color": 2,               "lineweight": "default", "linetype": "Continuous" },
    "inf_lp_gabion_3d":   { "color": 3,               "lineweight": 0.5,       "linetype": "Continuous" },
    "inf_lp_corridor":    { "color": 4,               "lineweight": 0.5,       "linetype": "Continuous" },
    "inf_lp_slope_hatch": { "color": 140,             "lineweight": "default", "linetype": "Continuous" },
