                      "Code":  "import clr, importlib, os, sys\n\nclr.AddReference(\"AecBaseMgd\")\nclr.AddReference(\"AeccDbMgd\")\nclr.AddReference(\"acmgd\")\nclr.AddReference(\"acdbmgd\")\n\ntry:\n    _LIB_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\nexcept NameError:\n    _LIB_ROOT = os.environ.get(\"ARHYZ_LIB_ROOT\", r\"C:\\Arhyz\\automation\\scripts\")\n\n_AUTOMATION_ROOT = os.path.dirname(_LIB_ROOT)\n\nif _LIB_ROOT not in sys.path:\n    sys.path.insert(0, _LIB_ROOT)\nif _AUTOMATION_ROOT not in sys.path:\n    sys.path.insert(0, _AUTOMATION_ROOT)\n\nfor _name in sorted(\n    [\n        m\n        for m in sys.modules\n        if m.startswith(\"draw_gabion_layout\") or m.startswith(\"civil\")\n    ],\n    reverse=True,\n):\n    try:\n        importlib.reload(sys.modules[_name])\n    except Exception:\n        del sys.modules[_name]\n\nfrom draw_gabion_layout.builder import GabionLayoutBuilder\n\nOUT = GabionLayoutBuilder(IN[0]).run()\n",
